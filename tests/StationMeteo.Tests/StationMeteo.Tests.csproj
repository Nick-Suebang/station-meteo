<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Logique de la station (indépendante de l'interface), compilée depuis la racine. -->
  <ItemGroup>
    <Compile Include="..\..\ICapteur.cs" Link="Origine\ICapteur.cs" />
    <Compile Include="..\..\IDonnees.cs" Link="Origine\IDonnees.cs" />
