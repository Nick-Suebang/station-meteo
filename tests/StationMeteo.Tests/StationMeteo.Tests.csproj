    <Compile Include="..\..\DonneesCsv.cs" Link="Origine\DonneesCsv.cs" />
    <Compile Include="..\..\DefinitionCapteur.cs" Link="Origine\DefinitionCapteur.cs" />
    <None Include="..\..\donnees.csv" Link="donnees.csv" CopyToOutputDirectory="PreserveNewest" />
