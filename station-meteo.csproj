<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>station_meteo</RootNamespace>
    <AssemblyName>station-meteo</AssemblyName>
    <AssemblyTitle>Station météo</AssemblyTitle>
    <Product>Station météo</Product>
    <Version>1.1.0</Version>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- La version web et les tests sont des projets séparés. -->
  <ItemGroup>
    <Compile Remove="web/**;tests/**" />
    <EmbeddedResource Remove="web/**;tests/**" />
    <None Remove="web/**;tests/**" />
    <Content Remove="web/**;tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="ZedGraph" Version="5.1.7" />
  </ItemGroup>

  <ItemGroup>
    <None Update="donnees.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
